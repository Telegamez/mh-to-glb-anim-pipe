# Per-character working artifacts — rebuild locally by running the pipeline.
# Patterns cover both the legacy flat layout (characters/<id>/...) and the
# per-UE-version-per-pipeline layout (5.x/<pipeline>/characters/<id>/...).
# These outputs are MetaHuman-licensed assets that can't ship under MIT.
characters/*/01-fbx/
characters/*/02-blend/
characters/*/03-glb/
characters/*/01-glb/
*/*/characters/*/01-fbx/
*/*/characters/*/02-blend/
*/*/characters/*/03-glb/
*/*/characters/*/01-glb/

# source/ holds the weight FBX files stage 01 exports for reweight_from_fbx.py and the npz
# dumped from them. Same reasoning as the stage folders above: rebuildable by re-running the
# pipeline, and they carry MetaHuman mesh data that cannot ship under MIT. The README that
# explains what belongs in the folder is kept.
characters/*/source/*
!characters/*/source/README.md
*/*/characters/*/source/*
!*/*/characters/*/source/README.md

# Contributors running the pipeline on their own MetaHumans: ignore any
# character folder that isn't one of the demo characters shipped in this repo.
# Add your own id to the allowlist locally if you want to track it in a fork.
#
# TELEGAMEZ: the six companions are allowlisted below. This is the fork, they
# are the product, and their manifest.json is not a build artifact — it is the
# only home of two settings that cannot be recovered by re-running anything:
#
#   wardrobe_overrides  Desert Boots ship from Fab as Color1 (1,1,1). Without
#                       the override every companion bakes in WHITE BOOTS, and
#                       recolouring the MI in UE does not survive because stage
#                       00 regenerates that folder on every re-bake.
#   exclude_meshes      Drops the duplicate second outfit mesh on tele/tele1.
#
# Losing the directory silently un-fixes both on the next bake, with nothing
# reporting a problem — the same failure shape as everything in §6.1 of the
# handoff doc. The stage-status timestamps in the same file do churn on every
# bake; that noise is the price of not losing the config, and splitting status
# out into its own file is the real fix whenever someone touches the stages.
#
# The stage-output ignores above still apply inside these folders — that is how
# ada already works: its manifest.json is tracked, its 03-glb/ is not.
characters/*
!characters/_shared/
!characters/_template/
!characters/ada/
!characters/taro/
!characters/telly/
!characters/tele/
!characters/telie/
!characters/telee/
!characters/tele1/
!characters/tele2/

# Same allowlist for versioned roots.
*/*/characters/*
!*/*/characters/_shared/
!*/*/characters/_template/
!*/*/characters/ada/
!*/*/characters/taro/
!*/*/characters/telly/
!*/*/characters/tele/
!*/*/characters/telie/
!*/*/characters/telee/
!*/*/characters/tele1/
!*/*/characters/tele2/

# Stage 04 gallery output — same allowlist. A contributor's local viewer
# still builds and renders fine; it just stays out of git.
docs/characters/*
!docs/characters/ada/
!docs/characters/taro/
*/*/docs/characters/*
!*/*/docs/characters/ada/
!*/*/docs/characters/taro/

# Final GLB outputs in docs/ — MetaHuman-licensed, not MIT-shippable.
docs/characters/*/*.glb
*/*/docs/characters/*/*.glb

# Python / tooling noise
__pycache__/
*.pyc
.venv/
.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local config — paths to your UE project, UE editor, Blender. See
# _config/pipeline.example.yaml for the template you copy from.
/_config/pipeline.yaml

# Blender scratch
*.blend1
*.blend@

# Local screenshots (not part of the repo; keep the ones referenced from README)
# ada-v3.png + ada-viewer.png are local dev captures — exclude by default
/ada-v3.png
/ada-viewer.png

# Claude Code / MCP scratch dirs
.claude/
.playwright-mcp/

# Exploratory / throwaway scripts + captures. Keep the reference baker
# (_scratch/bake_arkit_reference.py) around locally — its output
# skills/reference/arkit52_deltas.npz is the committed artifact.
_scratch/

# Stage 05 output — MetaHuman-licensed animation bake, regenerated by
# run_animbake.ps1. Same non-shippable rule as the character GLBs.
docs/animations/
*/*/docs/animations/

# Batch bake logs (tools/bake_batch.ps1)
5.7/native-glb/_logs/

# Ground-truth verification workspace (tools/verify_deformation.py,
# stages/05/tools/export_posed_mesh.py). Regenerable UE output, and
# MetaHuman-licensed like every other bake artifact.
5.7/native-glb/_work/

# Skinning-decomposition intermediates (tools/run_weight_solve.ps1).
# Per-character, regenerable, and large.
5.7/native-glb/characters/*/_solve/

# Stage 05 per-clip GLB scratch. One directory per animation set; regenerated on
# every bake and only meaningful between the UE half and the Blender half.
5.7/native-glb/stages/05-animation-bake/_work/

# CMake build trees from the riglogic spike. Never tracked on any branch, ~876 MB, and left
# on disk when a branch that has them is swapped out — so they turn up as untracked in front
# of whoever is about to stage everything. The spike's sources under tools/dna/ stay tracked.
tools/riglogic-spike/bt*/
tools/riglogic-spike/build-native/

# Stage 01's viseme authoring report — generated per run, like every other stage output.
5.7/native-glb/stages/01-unreal-glb-export/config/tg_viseme_authoring_report.json
